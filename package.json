{
  "name": "platforma-fonduri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test lib/*.test.mjs",
    "smoke:supabase": "node scripts/smoke-supabase.mjs",
    "dev:create-admin": "node scripts/create-local-admin.mjs",
    "smoke:duplicare": "node --experimental-strip-types scripts/smoke-duplicare.mjs",
    "seed:local": "node scripts/seed-local-demo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:sabloane": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/sabloane.spec.ts",
    "test:e2e:drepturi": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/drepturi.spec.ts",
    "test:e2e:drepturi-ui": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/drepturi-interfata.spec.ts",
    "test:e2e:regresii": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/regresii-senior.spec.ts",
    "test:e2e:verificare": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/verificare-modificari.spec.ts",
    "test:e2e:matricea-acces": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/matricea-acces.spec.ts",
    "test:e2e:incheiere": "E2E_ENV_FILE=${E2E_ENV_FILE:-.env.e2e.localdb} playwright test tests/e2e/incheiere-finalizare.spec.ts",
    "verifica": "npm run lint && tsc --noEmit && npm test && npm run build",
    "audit:check": "node --experimental-strip-types scripts/check-audit-contract.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:ui:telefon": "playwright test --config playwright.ui.config.ts --project telefon --project tableta",
    "test:ui:iphone": "UI_IPHONE=1 playwright test --config playwright.ui.config.ts --project iphone",
    "test:ui:raport": "playwright show-report playwright-report/ui"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.20",
    "@supabase/supabase-js": "^2.90.0",
    "archiver": "^7.0.1",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "react": "19.2.3",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.3",
    "resend": "^6.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.12",
    "supabase": "2.118.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "postcss": "^8.5.12",
    "svix": "^1.92.2",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
