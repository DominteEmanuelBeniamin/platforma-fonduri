# Configurare publică pentru pagina de confidențialitate.
# Înlocuiți placeholder-ele în mediul de deployment; nu comiteți valori reale.
NEXT_PUBLIC_PRIVACY_OPERATOR_NAME=REPLACE_WITH_OPERATOR_NAME
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=REPLACE_WITH_PRIVACY_EMAIL
NEXT_PUBLIC_PRIVACY_CONTACT_ADDRESS=REPLACE_WITH_PRIVACY_ADDRESS
NEXT_PUBLIC_PRIVACY_SUPERVISORY_AUTHORITY_NAME=REPLACE_WITH_AUTHORITY_NAME
NEXT_PUBLIC_PRIVACY_SUPERVISORY_AUTHORITY_URL=REPLACE_WITH_AUTHORITY_URL
# Required to authenticate scheduled cron requests.
CRON_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# Defaults to dry-run; set exactly to false only after policy approval and verification.
DATA_RETENTION_DRY_RUN=true
